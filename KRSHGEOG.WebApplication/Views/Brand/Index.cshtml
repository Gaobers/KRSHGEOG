@model IEnumerable<KRSHGEOG.BusinessLogic.DTOs.BrandResponse>

@{
    ViewData["Title"] = "Marcas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary mb-1">Marcas</h1>
            <p class="text-muted mb-0">Listado de marcas registradas</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Crear marca
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @Html.DisplayFor(modelItem => item.BrandName)
                            </td>
                            <td class="text-end">
                                @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-success me-2" })
                                @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>