@model IEnumerable<KRSHGEOG.BusinessLogic.DTOs.ProductoResponse>

@{
    ViewData["Title"] = "Listado de Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary mb-1">Productos</h1>
            <p class="text-muted mb-0">Listado de productos registrados</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Crear producto
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Marca</th>
                        <th>Nombre</th>
                        <th>Precio de Venta</th>
                        <th>Existencias</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.ToolBrandId)</td>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.ProductName)</td>
                            <td>@Html.DisplayFor(modelItem => item.SalePrice)</td>
                            <td>@Html.DisplayFor(modelItem => item.StockUnits)</td>
                            <td class="text-end">
                                @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-success" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>